PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devportfolio
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-development-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-development-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_BOOTSTRAP_SECRET=replace-with-development-bootstrap-secret
# Optional in development; required in production for shared rate limiting.
REDIS_URL=redis://localhost:6379
# Number of trusted reverse-proxy hops. Keep 0 when the API is directly exposed.
TRUST_PROXY=0
