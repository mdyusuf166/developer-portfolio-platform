{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/skills", "destination": "/index.html" },
    { "source": "/experience", "destination": "/index.html" },
    { "source": "/education", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/projects/:slug", "destination": "/index.html" },
    { "source": "/research", "destination": "/index.html" },
    { "source": "/achievements", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/resume", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
