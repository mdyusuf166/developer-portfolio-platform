{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@server/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
